# Copy to .env for a NEW deployment; never replace an existing .env during upgrades.
ADMIN_KEY=replace-with-a-strong-admin-code
# Required: generate with `openssl rand -hex 32` and paste the result below.
SESSION_SECRET=

# The example Compose file binds only to loopback until you choose otherwise.
BIND_ADDRESS=127.0.0.1
HOST_PORT=3003
# Legacy variable name retained for source compatibility: target landing URL.
CHATGPT_URL=https://example.org/
UPSTREAM_PROXY=none
PUBLIC_HOST=
ACME_ENABLED=false
HTTPS_REDIRECT=false
COOKIE_SECURE=false

STREAM_MAX_FPS=60
STREAM_MAX_WIDTH=8192
STREAM_MAX_HEIGHT=4320
MAX_ACTIVE_SESSIONS=12
MAX_UPLOAD_MB=500
SESSION_IDLE_MINUTES=60
DOWNLOAD_TTL_MINUTES=60
LOG_RETENTION_DAYS=7
